+local function caesar(s, shift)
+    local out = {}
+    for i = 1, #s do
+        local c = s:sub(i, i)
+        local b = c:byte()
+        if b >= 65 and b <= 90 then
+            out[i] = string.char((b - 65 + shift) % 26 + 65)
+        elseif b >= 97 and b <= 122 then
+            out[i] = string.char((b - 97 + shift) % 26 + 97)
+        else
+            out[i] = c
+        end
+    end
+    return table.concat(out)
+end
