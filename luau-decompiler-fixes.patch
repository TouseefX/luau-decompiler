+/// Is `name` read by a statement at an index in `(lo, hi)`?
+fn name_read_between(
+    index: &std::collections::HashMap<String, Vec<usize>>,
+    name: &str,
+    lo: usize,
+    hi: usize,
+) -> bool {
+    match index.get(name) {
+        Some(v) => {
+            let k = v.partition_point(|&j| j <= lo);
+            k < v.len() && v[k] < hi
+        }
+        None => false,
+    }
+}
